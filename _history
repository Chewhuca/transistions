{"entries":[{"timestamp":1793955364055,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.blocks","patch":[{"start1":0,"length1":1299,"diffs":[[1,"<xml xmlns=\"http://www.w3.org/1999/xhtml\">\n  <block type=\"pxt-on-start\"></block>\n  <block type=\"device_forever\"></block>\n</xml>"]]}]},{"type":"edited","filename":"main.ts","patch":[{"start1":0,"length1":339,"diffs":[[1,"\n"]]}]},{"type":"edited","filename":"pxt.json","patch":[{"start1":208,"length1":46,"diffs":[[1,"        \"README.md\"\n"]]},{"start1":235,"length1":31,"diffs":[[1,"    \"additionalFilePaths\": []\n"]]}]},{"type":"added","filename":"transitions.ts","value":"/**\n * Arten der Bildschirm-Überblendung\n */\nenum TransitionEffect {\n    //% block=\"Spirale\"\n    Spiral,\n    //% block=\"Zeilen (oben nach unten)\"\n    WipeDown,\n    //% block=\"Spalten (links nach rechts)\"\n    WipeRight,\n    //% block=\"Vorhang (horizontal)\"\n    CurtainH,\n    //% block=\"Diagonal\"\n    Diagonal,\n    //% block=\"Schachbrett\"\n    Checkerboard\n}\n\n/**\n * Benutzerdefinierte visuelle Übergänge für das micro:bit LED-Display\n */\n//% color=\"#E63946\" weight=100 icon=\"\\uf021\" block=\"Transitions\"\nnamespace Überblendungen {\n\n    /**\n     * Erzeugt den Koordinatenpfad basierend auf dem gewählten Effekt.\n     */\n    function getTransitionPath(effect: TransitionEffect): number[][] {\n        let path: number[][] = [];\n\n        switch (effect) {\n            case TransitionEffect.Spiral:\n                path = [\n                    [0, 0], [1, 0], [2, 0], [3, 0], [4, 0],\n                    [4, 1], [4, 2], [4, 3], [4, 4],\n                    [3, 4], [2, 4], [1, 4], [0, 4],\n                    [0, 3], [0, 2], [0, 1],\n                    [1, 1], [2, 1], [3, 1],\n                    [3, 2], [3, 3],\n                    [2, 3], [1, 3],\n                    [1, 2],\n                    [2, 2]\n                ];\n                break;\n\n            case TransitionEffect.WipeDown:\n                for (let y = 0; y < 5; y++) {\n                    for (let x = 0; x < 5; x++) {\n                        path.push([x, y]);\n                    }\n                }\n                break;\n\n            case TransitionEffect.WipeRight:\n                for (let x = 0; x < 5; x++) {\n                    for (let y = 0; y < 5; y++) {\n                        path.push([x, y]);\n                    }\n                }\n                break;\n\n            case TransitionEffect.CurtainH:\n                let colPairs = [[0, 4], [1, 3], [2, 2]];\n                for (let pair of colPairs) {\n                    let cols = pair[0] == pair[1] ? [pair[0]] : [pair[0], pair[1]];\n                    for (let c of cols) {\n                        for (let r = 0; r < 5; r++) {\n                            path.push([c, r]);\n                        }\n                    }\n                }\n                break;\n\n            case TransitionEffect.Diagonal:\n                for (let s = 0; s < 9; s++) {\n                    for (let x = 0; x < 5; x++) {\n                        let y = s - x;\n                        if (y >= 0 && y < 5) {\n                            path.push([x, y]);\n                        }\n                    }\n                }\n                break;\n\n            case TransitionEffect.Checkerboard:\n                let evens: number[][] = [];\n                let odds: number[][] = [];\n                for (let y = 0; y < 5; y++) {\n                    for (let x = 0; x < 5; x++) {\n                        if ((x + y) % 2 === 0) {\n                            evens.push([x, y]);\n                        } else {\n                            odds.push([x, y]);\n                        }\n                    }\n                }\n                path = evens.concat(odds);\n                break;\n        }\n\n        return path;\n    }\n\n    /**\n     * Füllt den Bildschirm im gewählten Muster und gibt ihn rückwärts frei,\n     * sodass am Ende nur das übergebene Bild sichtbar bleibt.\n     * @param targetImage Das Bild, das am Ende dargestellt werden soll\n     * @param effect Das Animationsmuster für den Übergang\n     * @param delayMs Verzögerungszeit pro Schritt in Millisekunden (z.B. 35)\n     */\n    //% block=\"überblende zu %targetImage mit %effect Verzögerung %delayMs ms\"\n    //% delayMs.defl=35\n    //% delayMs.min=5 delayMs.max=200\n    //% weight=90\n    export function showTransition(targetImage: Image, effect: TransitionEffect, delayMs: number = 35): void {\n        let path = getTransitionPath(effect);\n\n        // Phase 1: Vollständig nach Pfad füllen\n        for (let pt of path) {\n            led.plot(pt[0], pt[1]);\n            basic.pause(delayMs);\n        }\n\n        basic.pause(delayMs * 2);\n\n        // Phase 2: In umgekehrter Reihenfolge leeren und Ziel-Pixel behalten\n        for (let i = path.length - 1; i >= 0; i--) {\n            let x = path[i][0];\n            let y = path[i][1];\n            let brightness = targetImage.pixelBrightness(x, y);\n\n            if (brightness === 0) {\n                led.unplot(x, y);\n            } else {\n                led.plotBrightness(x, y, brightness);\n            }\n\n            basic.pause(delayMs);\n        }\n    }\n}"}]},{"timestamp":1793955732219,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.blocks","patch":[{"start1":0,"length1":407,"diffs":[[1,"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables></variables><block type=\"pxt-on-start\" x=\"372\" y=\"116\"><statement name=\"HANDLER\"><block type=\"Überblendungen_showTransition\"><field name=\"effect\">TransitionEffect.Checkerboard</field><value name=\"targetImage\"><block type=\"device_build_image\"><field name=\"LEDS\">`\n"]]},{"start1":423,"length1":642,"diffs":[[1,"        `</field></block></value><value name=\"delayMs\"><shadow type=\"math_number_minmax\"><mutation min=\"5\" max=\"200\" label=\"DelayMs\" precision=\"0\"></mutation><field name=\"SLIDER\">15</field></shadow></value><next><block type=\"device_pause\"><value name=\"pause\"><shadow type=\"timePicker\"><field name=\"ms\">100</field></shadow></value><next><block type=\"Überblendungen_showTransition\"><field name=\"effect\">TransitionEffect.Spiral</field><value name=\"targetImage\"><block type=\"device_build_image\"><field name=\"LEDS\">`\n"]]},{"start1":1029,"length1":296,"diffs":[[1,"        `</field></block></value><value name=\"delayMs\"><shadow type=\"math_number_minmax\"><mutation min=\"5\" max=\"200\" label=\"DelayMs\" precision=\"0\"></mutation><field name=\"SLIDER\">15</field></shadow></value></block></next></block></next></block></statement></block></xml>"]]}]},{"type":"edited","filename":"pxt.json","patch":[{"start1":261,"length1":44,"diffs":[[1,""]]}]},{"type":"added","filename":"test.ts","value":"// Hier kann man Tests durchführen; diese Datei wird nicht kompiliert, wenn dieses Paket als Erweiterung verwendet wird.\n"}]}],"snapshots":[{"timestamp":1793955364054,"editorVersion":"9.0.12","text":{"main.blocks":"<xml xmlns=\"http://www.w3.org/1999/xhtml\">\n  <block type=\"pxt-on-start\"></block>\n  <block type=\"device_forever\"></block>\n</xml>","main.ts":"\n","README.md":"","pxt.json":"{\n    \"name\": \"Transistions\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\"\n    ],\n    \"additionalFilePaths\": []\n}\n"}}],"shares":[],"lastSaveTime":1793956145010}